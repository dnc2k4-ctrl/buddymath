# ══════════════════════════════════════════════════════
#  BuddyMath BE — Sao chép thành .env và điền giá trị thực
# ══════════════════════════════════════════════════════

# ── Groq (LLM cho chat / classroom / synthesis) ───────
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_VISION_MODELS=model-a,model-b   # bổ sung model vision tuỳ chọn

# ── Jina AI (embedding cho RAG) ───────────────────────
# Lấy tại: https://jina.ai/embeddings/
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxx
JINA_MODEL=jina-embeddings-v3

# ── Claude (proxy tuỳ chọn, không bắt buộc) ───────────
# CLAUDE_API_KEY=sk-ant-api03-xxxx
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Pipeline tuning ───────────────────────────────────
LLM_TIMEOUT=60
RAG_TOP_K=5
HISTORY_WINDOW=10

# ── JWT ───────────────────────────────────────────────
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
# BẮT BUỘC đặt ở production — nếu để trống, JWT có thể bị giả mạo!
SECRET_KEY=thay-bang-chuoi-ngau-nhien-32-ky-tu
ACCESS_TOKEN_EXPIRE_HOURS=168

# ── Tài khoản admin & demo ────────────────────────────
# ADMIN_PASSWORD: mật khẩu tài khoản quản trị (admin@smartbuddy.vn). ĐẶT MẬT KHẨU MẠNH ở prod.
#   Nếu admin cũ còn dùng 'admin123', đặt biến này rồi deploy lại → hệ thống tự đổi sang mật khẩu mới.
# ENABLE_DEMO_ACCOUNTS=1 chỉ ở LOCAL/dev để có sẵn student@demo.vn / parent@demo.vn (demo123).
#   Production KHÔNG set biến này (để không seed tài khoản mật khẩu mặc định).
ADMIN_EMAIL=admin@smartbuddy.vn
ADMIN_PASSWORD=dat-mat-khau-manh-o-day
# ENABLE_DEMO_ACCOUNTS=1

# ── Database (mặc định SQLite trong BE/) ──────────────
# DATABASE_URL=sqlite:///./smartbuddy.db

# ── Email ─────────────────────────────────────────────
# KHUYẾN NGHỊ (production/cloud): dùng Brevo HTTP API vì Render/cloud CHẶN cổng SMTP.
# Tạo key ở https://app.brevo.com → SMTP & API → API Keys; xác minh FROM_EMAIL ở mục Senders.
# BREVO_API_KEY=xkeysib-xxxxxxxx
FROM_EMAIL=SmartBuddy <your-email@gmail.com>
# SMTP chỉ dùng khi chạy LOCAL (không có BREVO_API_KEY):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-16-chars

# ── URL công khai (dùng trong link email) ─────────────
PUBLIC_BASE_URL=http://localhost:8000

# ── Gửi báo cáo theo lịch (Standard = hàng tuần) ──────
# App tự chạy vòng lặp nền; ngoài ra có thể đặt CRON ngoài gọi mỗi ngày:
#   POST {PUBLIC_BASE_URL}/tasks/run-scheduled-reports  (header 'X-Task-Token: <token>')
# Đặt token bí mật để chặn người ngoài gọi. Bỏ trống = endpoint mở (chỉ nên ở local).
# SCHEDULER_TOKEN=chuoi-bi-mat-cho-cron

# ── CORS (production: đặt domain thật để siết) ────────
# ALLOWED_ORIGINS=https://tenmiencuaban.com

# ── Thanh toán VietQR + SePay ─────────────────────────
# BANK_CODE: mã NH theo VietQR/SePay (MB, VCB, TPB, ACB, VPB, TCB, BIDV...).
# Tạo webhook + lấy API key tại https://my.sepay.vn (liên kết TK ngân hàng của bạn).
# BANK_ACCOUNT_NUMBER=0123456789
# BANK_CODE=MB
# BANK_ACCOUNT_NAME=NGUYEN VAN A
# SEPAY_API_KEY=chuoi-bi-mat-dat-trung-tren-sepay
# ORDER_TTL_MIN=30
# ENABLE_MOCK_BILLING=false   # true = bật nâng gói GIẢ để dev (đừng bật ở production)

# ── Đường dẫn (tuỳ chọn — mặc định trỏ tới FE/ và BE/data) ──
# FRONTEND_DIR=../FE
# DATA_ROOT=./data
