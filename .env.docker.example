# ══════════════════════════════════════════════════════════════
#  Sao chép thành .env  (docker compose tự đọc file .env cùng thư mục)
#     cp .env.docker.example .env
#  rồi điền giá trị thật. TUYỆT ĐỐI không commit .env lên git.
# ══════════════════════════════════════════════════════════════

# ── Tên miền (dùng cho PUBLIC_BASE_URL + CORS). HTTPS do nginx + certbot lo. ──
DOMAIN=tenmien.com

# ── PostgreSQL (đặt mật khẩu mạnh) ─────────────────────────────
POSTGRES_PASSWORD=doi-mat-khau-postgres-manh

# ── JWT: bắt buộc. Sinh chuỗi: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu

# ── Tài khoản quản trị ─────────────────────────────────────────
ADMIN_EMAIL=admin@smartbuddy.vn
ADMIN_PASSWORD=dat-mat-khau-admin-manh

# ── LLM Groq + Embedding Jina (bắt buộc) ───────────────────────
# Groq:  https://console.groq.com/keys
# Jina:  https://jina.ai/embeddings/
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
JINA_MODEL=jina-embeddings-v3

# ── Chọn "bộ não" LLM (tuỳ chọn — mặc định Groq) ───────────────
# LLM_PROVIDER=groq   → dùng Groq/Llama (mặc định, miễn phí). Để trống cũng như vậy.
# LLM_PROVIDER=gemini → dùng Google Gemini (tiếng Việt tốt hơn) — CẦN đặt GEMINI_API_KEY.
#   Lấy key: https://aistudio.google.com/apikey . Gemini lỗi/hết quota → tự fallback Groq.
# LLM_PROVIDER=groq
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_VISION_MODEL=gemini-flash-latest

# (PUBLIC_BASE_URL và ALLOWED_ORIGINS tự suy ra https://${DOMAIN} trong docker-compose.yml)

# ── Email báo cáo phụ huynh (tuỳ chọn — bật nút "Gửi báo cáo qua email") ───────
# CHỌN 1 trong 2. KHUYẾN NGHỊ trên VPS: dùng Brevo (nhiều VPS chặn cổng SMTP ra ngoài).
#
# (A) Brevo HTTP API — không dùng cổng SMTP nên không bị chặn. Ưu tiên nếu điền.
#     Lấy key: https://app.brevo.com → SMTP & API → API Keys. Xác minh FROM_EMAIL ở mục Senders.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# FROM_EMAIL=SmartBuddy <no-reply@tenmien.com>
#
# (B) Gmail SMTP — CHỈ dùng khi KHÔNG có BREVO_API_KEY và VPS không chặn cổng 587.
#     SMTP_PASS là "App Password" 16 ký tự (myaccount.google.com/apppasswords, cần bật 2FA).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ban@gmail.com
# SMTP_PASS=app-password-16-ky-tu
# FROM_EMAIL=SmartBuddy <ban@gmail.com>

# ── Gửi báo cáo theo lịch (gói Standard = hàng tuần) — tuỳ chọn ────────────────
# App tự chạy vòng lặp nền (kiểm tra mỗi 6 giờ). Nếu muốn chắc ăn, đặt CRON ngoài gọi:
#   POST {PUBLIC_BASE_URL}/tasks/run-scheduled-reports  (header 'X-Task-Token: <token>')
# Đặt token bí mật để chặn người ngoài gọi. Bỏ trống = endpoint mở (chỉ nên ở local).
# SCHEDULER_TOKEN=chuoi-bi-mat-cho-cron

# ── Thanh toán VietQR + SePay (tuỳ chọn — bật nâng gói bằng chuyển khoản) ───────
# BANK_CODE: mã NH theo VietQR (MB, VCB, TPB, ACB, VPB, TCB, BIDV...).
# Tạo webhook + lấy API key tại https://my.sepay.vn (liên kết TK ngân hàng của bạn);
# SEPAY_API_KEY phải ĐẶT TRÙNG với cấu hình webhook trên SePay (để xác thực).
# BANK_ACCOUNT_NUMBER=0123456789
# BANK_CODE=MB
# BANK_ACCOUNT_NAME=NGUYEN VAN A
# SEPAY_API_KEY=chuoi-bi-mat-dat-trung-tren-sepay
# ORDER_TTL_MIN=30                # đơn hết hạn sau N phút
